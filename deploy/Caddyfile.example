# Caddyfile for serving the podcast output directory (feed.xml, cover, episodes/*.mp3).
#
# LAN variant: plain HTTP on a port; set feed.base_url to http://<lan-ip>:8080 in config.yaml.
# For HTTPS over Tailscale see Caddyfile.tailscale.example and deploy/README.md.
#
#   caddy run --config deploy/Caddyfile.example --adapter caddyfile
#
# Settings (environment variables, defaults in brackets):
#   PODCAST_ROOT  directory with the published files [/srv/podcast]
#   PODCAST_PORT  port to listen on                  [8080]

{
	# Everything runs in the local network: no certificates, no admin API.
	auto_https off
	admin off
}

:{$PODCAST_PORT:8080} {
	root * {$PODCAST_ROOT:/srv/podcast}

	# The feed changes with every run: clients must revalidate it (ETag / Last-Modified are
	# sent by file_server, so unchanged feeds cost a 304).
	@feed path /feed.xml
	header @feed Content-Type "application/rss+xml; charset=utf-8"
	header @feed Cache-Control "no-cache"

	# Episode files never change once published (their names contain date and id), so they
	# can be cached for a year. file_server answers Range requests, which podcast apps use for
	# seeking and resuming downloads.
	@audio path *.mp3
	header @audio Content-Type "audio/mpeg"
	header @audio Cache-Control "public, max-age=31536000, immutable"
	header @audio Accept-Ranges "bytes"

	# The cover is replaced rarely.
	@cover path_regexp cover ^/cover\.(jpg|jpeg|png)$
	header @cover Cache-Control "public, max-age=3600"

	# Only text is compressed; MP3 and images are already compressed.
	@text path /feed.xml
	encode @text gzip zstd

	# Directory listings and dotfiles stay private.
	@hidden path /.* /*/.*
	respond @hidden 404

	file_server
}
