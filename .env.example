# Secrets and environment overrides. Copy to .env (git-ignored). Never commit real keys.
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=
# Falls back to AZURE_FOUNDRY_API_KEY when empty/unset
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
# AZURE_SPEECH_ENDPOINT=

# Any config value can be overridden with C2P_ prefix and __ nesting:
# C2P_FEED__BASE_URL=http://my-host.tailnet.ts.net:8080
